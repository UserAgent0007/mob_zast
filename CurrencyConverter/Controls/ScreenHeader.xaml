<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CurrencyConverter.Controls.ScreenHeader">
    <VerticalStackLayout Spacing="4" Padding="0,0,0,8">
        <Label x:Name="KickerLabel"
               TextColor="{StaticResource Mint}"
               FontSize="12"
               FontAttributes="Bold"
               CharacterSpacing="1.2" />
        <Label x:Name="TitleLabel"
               TextColor="{StaticResource Text}"
               FontFamily="OpenSansSemibold"
               FontSize="28" />
        <Label x:Name="SubtitleLabel"
               TextColor="{StaticResource Muted}"
               FontSize="14" />
    </VerticalStackLayout>
</ContentView>
