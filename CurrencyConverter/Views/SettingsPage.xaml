<?xml version="1.0" encoding="UTF-8" ?>
<views:SessionPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:controls="clr-namespace:CurrencyConverter.Controls"
                   xmlns:views="clr-namespace:CurrencyConverter.Views"
                   xmlns:vm="clr-namespace:CurrencyConverter.ViewModels"
                   x:Class="CurrencyConverter.Views.SettingsPage"
                   x:DataType="vm:SettingsViewModel"
                   Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,28" Spacing="12">
            <controls:ScreenHeader Kicker="Профіль"
                                   Title="Налаштування"
                                   Subtitle="Точність, базова валюта та обране" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Знаків після коми" FontSize="16" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Text="2" Style="{StaticResource GhostButton}" Command="{Binding SelectDecimalsCommand}" CommandParameter="2">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding Decimals}" Value="2">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Mint}" />
                                    <Setter Property="TextColor" Value="{StaticResource Bg}" />
                                    <Setter Property="BorderWidth" Value="0" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" Text="4" Style="{StaticResource GhostButton}" Command="{Binding SelectDecimalsCommand}" CommandParameter="4">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding Decimals}" Value="4">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Mint}" />
                                    <Setter Property="TextColor" Value="{StaticResource Bg}" />
                                    <Setter Property="BorderWidth" Value="0" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="2" Text="6" Style="{StaticResource GhostButton}" Command="{Binding SelectDecimalsCommand}" CommandParameter="6">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding Decimals}" Value="6">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Mint}" />
                                    <Setter Property="TextColor" Value="{StaticResource Bg}" />
                                    <Setter Property="BorderWidth" Value="0" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChooseBaseCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6">
                    <Label Text="База для таблиці курсів" FontSize="16" FontAttributes="Bold" />
                    <Label Text="{Binding BaseText}" TextColor="{StaticResource Mint}" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Обрані валюти" FontSize="16" FontAttributes="Bold" />
                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                BindableLayout.ItemsSource="{Binding Favorites}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:FavoriteChip">
                                <Button Text="{Binding Code}"
                                        Margin="0,0,8,8"
                                        Style="{StaticResource ChipButton}"
                                        TextColor="{StaticResource Text}"
                                        BackgroundColor="{StaticResource MintDeep}"
                                        Command="{Binding BindingContext.ToggleFavoriteCommand, Source={RelativeSource AncestorType={x:Type views:SettingsPage}}}"
                                        CommandParameter="{Binding Code}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Label Text="Натисніть валюту, щоб прибрати її з обраного."
                           TextColor="{StaticResource Muted}"
                           FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Джерело даних" FontSize="16" FontAttributes="Bold" />
                    <Label Text="{Binding ProviderText}" TextColor="{StaticResource Mint}" FontAttributes="Bold" />
                    <Label Text="{Binding UpdatedText}" TextColor="{StaticResource Muted}" FontSize="13" />
                    <Button Text="Оновити курси зараз"
                            Style="{StaticResource GhostButton}"
                            TextColor="{StaticResource Mint}"
                            Command="{Binding RefreshRatesCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Архітектура" FontSize="16" FontAttributes="Bold" />
                    <Label Text="{Binding ArchitectureText}" TextColor="{StaticResource Muted}" FontSize="13" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</views:SessionPage>
