<?xml version="1.0" encoding="UTF-8" ?>
<views:SessionPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:controls="clr-namespace:CurrencyConverter.Controls"
                   xmlns:views="clr-namespace:CurrencyConverter.Views"
                   xmlns:vm="clr-namespace:CurrencyConverter.ViewModels"
                   x:Class="CurrencyConverter.Views.RatesPage"
                   x:DataType="vm:RatesViewModel"
                   Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12,16,8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <controls:ScreenHeader Kicker="Ринок" Title="Курси" Subtitle="{Binding Subtitle}" />
            <Border Grid.Column="1"
                    Style="{StaticResource Card}"
                    Padding="10,8"
                    VerticalOptions="Start"
                    HorizontalOptions="End">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChooseBaseCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="2">
                    <controls:CurrencyMark Code="{Binding BaseCode}" Size="28" />
                    <Label Text="{Binding BaseCode}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,0" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="⌕" TextColor="{StaticResource Muted}" FontSize="18" VerticalOptions="Center" />
                <Entry Grid.Column="1" Text="{Binding Query, Mode=TwoWay}" Placeholder="Пошук валюти" FontSize="16" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <RefreshView IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}" Command="{Binding RefreshRatesCommand}">
                <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RateRowItem">
                            <Grid ColumnDefinitions="Auto,*,Auto,44" ColumnSpacing="10" Padding="4,10">
                                <Grid Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.OpenRateCommand, Source={RelativeSource AncestorType={x:Type views:RatesPage}}}"
                                            CommandParameter="{Binding Code}" />
                                    </Grid.GestureRecognizers>
                                    <controls:CurrencyMark Code="{Binding Code}" Size="36" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Code}" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="{Binding Name}" TextColor="{StaticResource Muted}" FontSize="12" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           Text="{Binding ValueText}"
                                           TextColor="{StaticResource Mint}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Button Grid.Column="3"
                                        Text="{Binding Star}"
                                        TextColor="{Binding StarColor}"
                                        BackgroundColor="Transparent"
                                        FontSize="18"
                                        Padding="0"
                                        Command="{Binding BindingContext.ToggleFavoriteCommand, Source={RelativeSource AncestorType={x:Type views:RatesPage}}}"
                                        CommandParameter="{Binding Code}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Mint}"
                               WidthRequest="48"
                               HeightRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding ShowEmpty}"
                                 Spacing="12"
                                 Padding="24"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                <Label Text="{Binding EmptyTitle}"
                       FontSize="16"
                       HorizontalTextAlignment="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding HasError}" Value="True">
                            <Setter Property="TextColor" Value="{StaticResource Danger}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Button Text="Спробувати ще раз"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding RefreshRatesCommand}"
                        IsVisible="{Binding HasError}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</views:SessionPage>
