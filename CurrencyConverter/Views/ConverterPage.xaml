<?xml version="1.0" encoding="UTF-8" ?>
<views:SessionPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:controls="clr-namespace:CurrencyConverter.Controls"
                   xmlns:views="clr-namespace:CurrencyConverter.Views"
                   xmlns:vm="clr-namespace:CurrencyConverter.ViewModels"
                   x:Class="CurrencyConverter.Views.ConverterPage"
                   x:DataType="vm:ConverterViewModel"
                   Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,28" Spacing="12">
            <controls:ScreenHeader Kicker="Live rates"
                                   Title="Конвертер"
                                   Subtitle="{Binding Subtitle}"
                                   SubtitleColor="{Binding SubtitleColor}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Сума" TextColor="{StaticResource Muted}" FontSize="13" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <controls:CurrencyMark Grid.Column="0" Code="{Binding FromCode}" Size="36" VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Text="{Binding Amount, Mode=TwoWay}"
                               Placeholder="0"
                               Keyboard="Numeric"
                               FontSize="36"
                               VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Start">
                <Button Text="1" Margin="0,0,8,8" Style="{StaticResource ChipButton}" Command="{Binding SelectQuickAmountCommand}" CommandParameter="1" />
                <Button Text="10" Margin="0,0,8,8" Style="{StaticResource ChipButton}" Command="{Binding SelectQuickAmountCommand}" CommandParameter="10" />
                <Button Text="50" Margin="0,0,8,8" Style="{StaticResource ChipButton}" Command="{Binding SelectQuickAmountCommand}" CommandParameter="50" />
                <Button Text="100" Margin="0,0,8,8" Style="{StaticResource ChipButton}" Command="{Binding SelectQuickAmountCommand}" CommandParameter="100" />
                <Button Text="500" Margin="0,0,8,8" Style="{StaticResource ChipButton}" Command="{Binding SelectQuickAmountCommand}" CommandParameter="500" />
                <Button Text="1000" Margin="0,0,8,8" Style="{StaticResource ChipButton}" Command="{Binding SelectQuickAmountCommand}" CommandParameter="1000" />
            </FlexLayout>

            <Border Style="{StaticResource Card}" Padding="12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChooseFromCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <controls:CurrencyMark Code="{Binding FromCode}" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="З ВАЛЮТИ" TextColor="{StaticResource Muted}" FontSize="11" CharacterSpacing="0.6" />
                        <Label Text="{Binding FromCode}" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding FromName}" TextColor="{StaticResource Muted}" FontSize="12" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="▾" TextColor="{StaticResource Muted}" FontSize="18" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Button Text="⇅"
                    Command="{Binding SwapCommand}"
                    BackgroundColor="{StaticResource Mint}"
                    TextColor="{StaticResource Bg}"
                    FontSize="20"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    Padding="0"
                    HorizontalOptions="Center" />

            <Border Style="{StaticResource Card}" Padding="12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChooseToCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <controls:CurrencyMark Code="{Binding ToCode}" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="У ВАЛЮТУ" TextColor="{StaticResource Muted}" FontSize="11" CharacterSpacing="0.6" />
                        <Label Text="{Binding ToCode}" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding ToName}" TextColor="{StaticResource Muted}" FontSize="12" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="▾" TextColor="{StaticResource Muted}" FontSize="18" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border BackgroundColor="{StaticResource MintDeep}"
                    Stroke="{StaticResource Line}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="18">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Результат" TextColor="{StaticResource Muted}" FontSize="13" FontAttributes="Bold" />
                    <Label Text="{Binding ResultText}" TextColor="{StaticResource Mint}" FontSize="40" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding RateText}" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Зберегти в історію"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSave}" />

            <Button Text="Оновити курси"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding RefreshRatesCommand}"
                    IsVisible="{Binding ShowRetry}" />

            <Label Text="Популярні пари" FontSize="16" FontAttributes="Bold" Margin="0,8,0,0" />
            <FlexLayout Wrap="Wrap"
                        Direction="Row"
                        BindableLayout.ItemsSource="{Binding Popular}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:PopularPair">
                        <Button Text="{Binding Label}"
                                Margin="0,0,8,8"
                                Style="{StaticResource ChipButton}"
                                TextColor="{StaticResource Text}"
                                BackgroundColor="{StaticResource Surface}"
                                Command="{Binding BindingContext.SelectPopularCommand, Source={RelativeSource AncestorType={x:Type views:ConverterPage}}}"
                                CommandParameter="{Binding Code}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </VerticalStackLayout>
    </ScrollView>
</views:SessionPage>
